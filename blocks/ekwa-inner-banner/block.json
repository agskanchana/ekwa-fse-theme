{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ekwa/inner-banner",
	"version": "1.0.0",
	"title": "Ekwa Inner Page Banner (Legacy)",
	"category": "ekwa-dynamic",
	"icon": "format-image",
	"description": "Deprecated — use Ekwa Page Banner, which composes the same title and breadcrumb logic out of inner blocks. Kept registered so existing pages and templates keep rendering exactly as before.",
	"textdomain": "ekwa",
	"keywords": [ "banner", "header", "hero", "page", "inner" ],
	"supports": {
		"html": false,
		"inserter": false,
		"anchor": true,
		"align": [ "full", "wide" ],
		"color": {
			"background": true,
			"text": true
		}
	},
	"attributes": {
		"overlayOpacity": {
			"type": "number",
			"default": 50
		},
		"minHeight": {
			"type": "number",
			"default": 200
		},
		"showBreadcrumbs": {
			"type": "boolean",
			"default": true
		},
		"ariaLabel": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "ekwa-inner-banner-editor"
}
