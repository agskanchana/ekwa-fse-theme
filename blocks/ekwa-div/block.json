{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ekwa/div",
	"version": "1.0.0",
	"title": "Ekwa Div",
	"category": "ekwa-layout",
	"icon": "screenoptions",
	"description": "Clean wrapper element — outputs only your tag, classes, and children. No layout styles.",
	"textdomain": "ekwa",
	"keywords": [ "div", "wrapper", "section", "container", "raw" ],
	"supports": {
		"html": false,
		"anchor": true,
		"className": true
	},
	"attributes": {
		"tagName":           { "type": "string",  "default": "div" },
		"href":              { "type": "string",  "default": "" },
		"url":               { "type": "string",  "default": "" },
		"linkType":          { "type": "string",  "default": "external" },
		"pageType":          { "type": "string",  "default": "page" },
		"pageId":            { "type": "number",  "default": 0 },
		"mediaUrl":          { "type": "string",  "default": "" },
		"mediaFileId":       { "type": "number",  "default": 0 },
		"target":            { "type": "string",  "default": "" },
		"rel":               { "type": "string",  "default": "" },
		"backgroundImage":   { "type": "string",  "default": "" },
		"backgroundImageId": { "type": "number",  "default": 0 },
		"lazyBg":            { "type": "boolean", "default": true },
		"preloadBg":         { "type": "boolean", "default": false },
		"inlineStyle":       { "type": "string",  "default": "" },
		"scopedCss":         { "type": "string",  "default": "" },
		"scopedCssOffInEditor": { "type": "boolean", "default": false },
		"customAttributes":  { "type": "object",  "default": {} },
		"lightbox":        { "type": "boolean", "default": false },
		"lightboxGroup":   { "type": "string",  "default": "" },
		"lightboxCaption": { "type": "string",  "default": "" }
	},
	"editorScript": "ekwa-div-editor"
}
