{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ekwa/related-posts",
	"version": "1.1.0",
	"title": "Ekwa Related Posts (deprecated)",
	"category": "ekwa-blog",
	"icon": "admin-post",
	"description": "Deprecated — use Ekwa Related Articles instead, which does the same thing and adds carousel and grid layouts. Existing blocks keep working; select one and use Transform to move it over.",
	"textdomain": "ekwa",
	"keywords": [ "related", "posts", "footer", "context", "deprecated" ],
	"supports": { "html": false, "inserter": false },
	"attributes": {
		"headingLevel":            { "type": "string", "default": "h2" },
		"singularLabel":           { "type": "string", "default": "Related article" },
		"pluralLabel":             { "type": "string", "default": "Related articles" },
		"featuredSingularLabel":   { "type": "string", "default": "Featured article" },
		"featuredPluralLabel":     { "type": "string", "default": "Featured articles" },
		"featuredCategorySlug":    { "type": "string", "default": "featured-articles" },
		"count":                   { "type": "number", "default": 3 },
		"hideHeading":             { "type": "boolean", "default": false }
	},
	"editorScript": "ekwa-related-posts-editor"
}
